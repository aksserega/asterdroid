# Скопируйте в /etc/alice-claude.env и заполните.
ANTHROPIC_API_KEY=sk-ant-...

# Секретный путь webhook'а: придумайте свой, чтобы никто чужой не нашёл навык.
ALICE_PATH=/alice/change-me-to-something-random

# Заполните после первого запуска (значения видно в журнале, см. README).
ALICE_SKILL_ID=
ALICE_USER_IDS=

ASSISTANT_NAME=Claude
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=400
REPLY_BUDGET=2.4
HISTORY_TURNS=8

HOST=127.0.0.1
PORT=8080
